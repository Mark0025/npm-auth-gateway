# Auth provider: "clerk" or "oidc"
AUTH_PROVIDER=oidc

# Clerk Auth (used when AUTH_PROVIDER=clerk)
# Get from https://clerk.com/dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Auth.js / NextAuth OIDC (used when AUTH_PROVIDER=oidc)
# AUTH_SECRET is required in production.
# AUTH_URL and NEXTAUTH_URL are aliases in Auth.js v5; set one of them.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3100
# NEXTAUTH_URL=http://localhost:3100
OIDC_ISSUER=https://auth.example.com/application/o/my-app
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret

# NPM API credentials (an admin user in your NPM instance)
NPM_API_EMAIL=admin@example.com
NPM_API_PASSWORD=changeme
NPM_API_URL=http://nginx-proxy-manager:81/api
